# Make the path/cdpath arrays (tied to $PATH/$CDPATH) auto-dedupe on
# assignment, so we don't need to fork `awk` afterwards to strip duplicates.
typeset -U path cdpath

# Prepend new items to path (if directory exists)

prepend-path "/bin"
prepend-path "/usr/bin"
prepend-path "/usr/local/bin"
#hard encoded brew --prefix to speed up init
# prepend-path "/usr/local/opt/coreutils/libexec/gnubin"
# prepend-path "/usr/local/opt/gnu-sed/libexec/gnubin"
# prepend-path "/usr/local/opt/grep/libexec/gnubin"
prepend-path "/sbin"
prepend-path "/usr/sbin"
prepend-path "/usr/local/sbin"
# Homebrew arm64
prepend-path "/opt/homebrew/bin"
prepend-path "/opt/homebrew/sbin"
# Linuxbrew. On macOS, /home is a live autofs automount trigger (auto_home,
# backed by Open Directory) - stat'ing anything under it makes the
# automounter do a directory-service lookup, costing ~15-20ms on every
# shell startup even though the path never exists here. Only touch it on
# actual Linux.
[[ $OSTYPE == linux* ]] && prepend-path "/home/linuxbrew/.linuxbrew/bin"

# User paths
prepend-path "$DOTFILES_DIR/bin"
prepend-path "$HOME/bin"
prepend-path "$HOME/.local/bin"

# Conda
prepend-path "$HOME/miniconda/bin"

CDPATH=.:~:~/projects:"$(dirname "$DOTFILES_DIR")"

# Wrap up

export PATH
export CDPATH
