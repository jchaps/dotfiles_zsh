
# Make the fpath array (tied to $FPATH) auto-dedupe on assignment - without
# this, anything that prepends to fpath more than once per shell (e.g. this
# repo's own .zshrc re-sourcing ~/.zprofile) stacks duplicate entries that
# persist and grow across nested/inherited shells, since FPATH is exported.
typeset -U fpath

# case insensitive path-completion
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*'

# partial completion suggestions
zstyle ':completion:*' list-suffixes
zstyle ':completion:*' expand prefix suffix

# conda completion
fpath+="$DOTFILES_DIR"/bin/conda-zsh-completion

# Homebrew's site-functions dir is already added to fpath by `brew shellenv`
# (called in system/opt), so nothing to do here.

# compinit's security audit (compaudit) stats every directory in $fpath and
# is the single biggest cost in shell startup (~100ms+ the first time,
# ~15-20ms on every run after). Only pay for the full audit once a day;
# otherwise skip straight to the cached dump with -C.
_zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
autoload -Uz compinit
if [[ -n ${_zcompdump}(#qN.mh+24) ]]; then
  compinit -u
else
  compinit -C -u
fi

# Byte-compile the dump so future shells parse it faster than raw zsh source.
if [[ -s "$_zcompdump" && ( ! -s "$_zcompdump.zwc" || "$_zcompdump" -nt "$_zcompdump.zwc" ) ]]; then
  zcompile "$_zcompdump"
fi
unset _zcompdump
